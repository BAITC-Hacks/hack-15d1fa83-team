{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arys.example/schemas/ml-input.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "turbine_id",
    "weather_model",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "windpower.input.v1"
    },
    "turbine_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "weather_model": {
      "const": "jma_gsm"
    },
    "records": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_time",
          "wind_speed_10m_ms",
          "wind_direction_10m_deg",
          "temperature_2m_c"
        ],
        "properties": {
          "target_time": {
            "type": "string",
            "format": "date-time",
            "description": "Timezone-aware consecutive whole hours; UTC Z preferred."
          },
          "wind_speed_10m_ms": {
            "type": "number",
            "minimum": 0
          },
          "wind_direction_10m_deg": {
            "type": "number",
            "minimum": 0,
            "maximum": 360
          },
          "temperature_2m_c": {
            "type": "number",
            "minimum": -273.15
          }
        }
      }
    }
  }
}
