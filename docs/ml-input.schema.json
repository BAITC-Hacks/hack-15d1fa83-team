{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ML input v1.0",
  "type": "object",
  "required": [
    "turbine_id",
    "records"
  ],
  "additionalProperties": false,
  "properties": {
    "turbine_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "records": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48,
      "items": {
        "type": "object",
        "required": [
          "target_time",
          "wind_speed",
          "wind_direction",
          "temperature",
          "pressure",
          "weather_model",
          "forecast_age_hours"
        ],
        "additionalProperties": false,
        "properties": {
          "target_time": {
            "type": "string",
            "format": "date-time",
            "description": "UTC full hour; 48 consecutive timestamps"
          },
          "wind_speed": {
            "type": "number",
            "minimum": 0,
            "maximum": 150,
            "description": "m/s at 100 m"
          },
          "wind_direction": {
            "type": "number",
            "minimum": 0,
            "maximum": 360,
            "description": "meteorological degrees at 100 m"
          },
          "temperature": {
            "type": "number",
            "minimum": -100,
            "maximum": 70,
            "description": "Celsius at 2 m"
          },
          "pressure": {
            "type": "number",
            "minimum": 300,
            "maximum": 1100,
            "description": "surface pressure hPa"
          },
          "weather_model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "forecast_age_hours": {
            "type": "number",
            "minimum": 0,
            "description": "as_of minus issued_at, hours"
          }
        }
      }
    }
  }
}
