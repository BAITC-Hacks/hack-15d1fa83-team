# Export variables in your shell. Python applications do not implicitly load .env.
# Compose reads .env for variable substitution only.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# Separate Django server-to-server credential (browser uses session/CSRF).
API_TOKEN=
DJANGO_DB_PATH=
ML_BACKEND=http
ML_SERVICE_URL=http://127.0.0.1:8001/v1/predict
ML_METADATA_URL=
# Shared between Django and ML. NOT an NVIDIA key.
ML_SERVICE_TOKEN=
HTTP_TIMEOUT=30
MODEL_PATH=models/production/model.json
# Explicit opt-in required for the committed provisional artifact.
ALLOW_PROVISIONAL_MODEL=0
# Legacy ML /power/forecast only; leave empty for the integrated direct-predict flow.
WEATHER_PROVIDER_URL=
WEATHER_PROVIDER_TOKEN=
WEATHER_TIMEOUT_SECONDS=15
ALLOW_HISTORICAL_FORECASTS=0
