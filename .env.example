# Complete stack: run python deployment/configure.py to generate private values.
# Compose reads .env automatically; native Python commands do not.
COMPOSE_PROJECT_NAME=windpower-pre-final
WEB_PORT=18080
DJANGO_SECRET_KEY=
API_TOKEN=
ML_BACKEND=http
ML_SERVICE_URL=http://127.0.0.1:8001/v1/predict
MODEL_PATH=models/production/model.json
# Optional shared token: configure the same value on Django and this service.
ML_SERVICE_TOKEN=
# Optional convenience endpoint only; /v1/predict needs no weather URL.
WEATHER_PROVIDER_URL=
# Optional authentication for the teammate's weather module, not an NVIDIA key.
WEATHER_PROVIDER_TOKEN=
WEATHER_TIMEOUT_SECONDS=15
ALLOW_HISTORICAL_FORECASTS=0
ALLOW_PROVISIONAL_MODEL=0
