# Variables must be exported by your shell; Django does not implicitly load .env.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
API_TOKEN=replace-for-server-to-server-calls
ML_BACKEND=demo
ML_SERVICE_URL=http://127.0.0.1:8001/v1/predict
# Optional; defaults to the /metadata sibling of ML_SERVICE_URL.
ML_METADATA_URL=
# Shared ML-service token, NOT an NVIDIA API key.
ML_SERVICE_TOKEN=
HTTP_TIMEOUT=30
