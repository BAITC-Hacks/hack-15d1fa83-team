FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DJANGO_SETTINGS_MODULE=config.settings
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && useradd --create-home appuser
COPY manage.py .
COPY config ./config
COPY common ./common
COPY forecasting ./forecasting
COPY weather_archive ./weather_archive
COPY templates ./templates
COPY static ./static
COPY deployment ./deployment
RUN mkdir -p /data /app/staticfiles && chown -R appuser:appuser /data /app/staticfiles
USER appuser
EXPOSE 8000
CMD ["python", "deployment/start_web.py"]
